@{
    var socials = new[]
    {
        new { Icon = "fa-facebook-f", Color = "#3b5998", Url = "#!" },
        new { Icon = "fa-twitter", Color = "#55acee", Url = "#!" },
        new { Icon = "fa-google", Color = "#dd4b39", Url = "#!" },
        new { Icon = "fa-instagram", Color = "#ac2bac", Url = "#!" },
        new { Icon = "fa-linkedin-in", Color = "#0082ca", Url = "#!" },
        new { Icon = "fa-github", Color = "#333333", Url = "#!" },
    };
}

<footer class="text-center text-white shadow-sm brand-gradient">
  <div class="container py-3"></div>

  <section class="mb-4">
    @foreach (var s in socials)
    {
      <a class="btn btn-floating m-1" style="background-color: @s.Color;" href="@s.Url" role="button">
        <i class="fab @s.Icon"></i>
      </a>
    }
  </section>

  <div class="text-center py-3" style="background: rgba(0, 0, 0, 0.1);">
    © @DateTime.Now.Year Copyright:
    <a class="text-white fw-bold" href="/" style="text-decoration: underline;">Umair's Portfolio</a>
  </div>
</footer>
